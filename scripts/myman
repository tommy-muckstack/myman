#!/bin/bash
# No npm install needed. Resolve symlinks so ~/.local/bin/myman works too.
set -euo pipefail
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_parent="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" = /* ]] || script_path="$script_parent/$script_path"
done
script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
# Lets `myman install-cli` and doctor hints name the exact helper path.
export MYMAN_HELPER_PATH="$script_dir/${script_path##*/}"
if ! command -v node >/dev/null 2>&1; then
  echo '{"ok":false,"error":{"code":"NODE_REQUIRED","message":"Install Node.js 22 or newer on this Mac.","hint":"Install Node.js 22+ (https://nodejs.org or: brew install node). Over SSH or from an agent, make sure node is on PATH for non-interactive shells, for example: echo \"export PATH=/opt/homebrew/bin:$PATH\" >> ~/.zshenv"}}'
  exit 6
fi
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' 2>/dev/null; then
  echo '{"ok":false,"error":{"code":"NODE_REQUIRED","message":"My Man requires Node.js 22 or newer.","hint":"Upgrade Node.js to 22+ (brew upgrade node) and make sure that version is first on PATH for non-interactive shells (~/.zshenv)."}}'
  exit 6
fi
for companion in "$script_dir/BrainCompanion/cli.mjs" "$script_dir/MyMan_MyMan.bundle/BrainCompanion/cli.mjs" "$script_dir/MyMan_MyMan.bundle/Contents/Resources/BrainCompanion/cli.mjs" "$script_dir/../src/Resources/BrainCompanion/cli.mjs" "$script_dir/cli.mjs" "$HOME/MyManBrain/tools/cli.mjs"; do
  if [[ -f "$companion" ]]; then exec node "$companion" "$@"; fi
done
echo '{"ok":false,"error":{"code":"COMPANION_MISSING","message":"Open the updated My Man app once to install its bundled CLI.","hint":"Launch the app with: open -a \"My Man\" (it must be installed in /Applications), then retry."}}'
exit 6
