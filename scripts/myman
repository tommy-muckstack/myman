#!/bin/bash
# Installed/exported companion works without npm install; Node.js 22+ required.
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$script_dir/../src/Resources/BrainCompanion/cli.mjs" ]]; then
  exec node "$script_dir/../src/Resources/BrainCompanion/cli.mjs" "$@"
fi
exec node "$HOME/MyManBrain/tools/cli.mjs" "$@"
