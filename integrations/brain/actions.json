            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "arrow",
                    "box",
                    "highlight",
                    "text",
                    "pixelate",
                    "image",
                    "circle",
                    "callout"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "[x,y,width,height]; desktop points bottom-left for capture, image pixels top-left for markup."
                },
                "from": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "to": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "font_size": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 300
                },
                "target_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "target_region": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "number": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "crop": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x,y,width,height]; desktop points bottom-left for capture, image pixels top-left for markup."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
