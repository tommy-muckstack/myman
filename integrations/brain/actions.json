    {
      "name": "screenshot.capture",
      "description": "Capture a display or desktop region; save and index it. No interactive selection. Clipboard changes only if requested.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "region": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x,y,width,height]. Global AppKit points (bottom-left), or display-local points (top-left) when display is supplied. Explicit coordinates overrides default."
          },
          "clipboard": {
            "type": "boolean"
          },
          "coordinates": {
            "type": "string",
            "enum": [
              "global",
              "display-local"
            ]
          },
          "window_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "open_editor": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "readOnly": false,
      "destructive": false,
      "permissions": [
        "capture"
      ]
    },
    {
      "name": "screenshot.edit",
      "description": "Validate and render markup in original image pixels (top-left), saving a new capture with refreshed OCR. The source is preserved. dry_run validates without saving. Per-operation colors and text font_size supported; crop is applied last. Supports OCR target_text/target_region, circles and numbered callouts. preview renders a temporary PNG without saving a library item; dry_run only validates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "annotations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "arrow",
                    "box",
                    "highlight",
                    "text",
                    "pixelate",
                    "image",
                    "circle",
                    "callout"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "[x,y,width,height]; desktop points bottom-left for capture, image pixels top-left for markup."
                },
                "from": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "to": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "font_size": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 300
                },
                "target_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "target_region": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "number": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "crop": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x,y,width,height]; desktop points bottom-left for capture, image pixels top-left for markup."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "background": {
            "type": "string",
            "enum": [
              "none",
              "dusk",
              "ocean",
              "meadow",
              "slate"
            ]
          },
          "corner_radius": {
            "type": "number",
            "minimum": 0,
            "maximum": 300
          },
          "clipboard": {
            "type": "boolean"
          },
          "background_color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "dry_run": {
            "type": "boolean"
          },
          "open_editor": {
            "type": "boolean"
          },
          "preview": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "readOnly": false,
      "destructive": false,
      "permissions": [
        "markup"
      ]
    },
