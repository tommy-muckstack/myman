pkgbase = myman-bin
	pkgdesc = Local-first screenshots, markup, recordings and notes that people and AI agents can use (Linux and Omarchy)
	pkgver = 1.1.100
	pkgrel = 1
	url = https://github.com/tommy-muckstack/myman
	install = myman.install
	arch = any
	license = MIT
	license = OFL-1.1
	depends = nodejs>=22
	depends = git
	optdepends = grim: screenshots on Wayland and Hyprland
	optdepends = slurp: drag to select part of the screen on Wayland (myman show)
	optdepends = imagemagick: screenshots and markup on X11
	optdepends = librsvg: markup rendering
	optdepends = ttf-dejavu: markup labels
	optdepends = tesseract: read text in screenshots
	optdepends = tesseract-data-eng: English text recognition
	optdepends = libnotify: desktop notifications for timers and myman show
	optdepends = wf-recorder: screen recording on Wayland
	optdepends = ffmpeg: screen recording on X11 and recording export
	optdepends = xdotool: cursor tracking in recordings on X11
	optdepends = xorg-xinput: clicks and typing moments in recording cursor tracks on X11
	optdepends = voxtype-bin: local dictation saved to the Brain (myman dictation connect)
	optdepends = whisper.cpp: meeting transcripts on this computer (voxtype also works)
	optdepends = pipewire-pulse: microphone and computer audio for meetings
	optdepends = hyprland: Omarchy key binding and menu (myman omarchy install)
	provides = myman
	conflicts = myman
	source = myman-bin-1.1.100.tar.gz::https://github.com/tommy-muckstack/myman/releases/download/v1.1.100/myman-linux-x64.tar.gz
	sha256sums = 9e1dd32c79955c14f109907226645bfcbf2ac923de4acc6527ca1ce330290a25

pkgname = myman-bin
